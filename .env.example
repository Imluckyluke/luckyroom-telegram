PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The ONE phone number that owns the monitoring dashboard (no hardcoded
# fallback exists — whoever registers with this number becomes the sole
# super_admin; everyone else is stripped of admin roles on every boot).
SUPER_ADMIN_PHONE=09123456789
DB_PATH=./data/chat.db
# Optional: where super-admin database backups are stored (defaults to a
# "backups" folder next to the database file)
# BACKUP_DIR=./data/backups
CORS_ORIGIN=*

# Uploads (file system)
UPLOAD_DIR=./uploads

# Per-category size limits (MB) and allowed MIME types
MAX_FILE_SIZE_MB=20
FILE_ALLOWED_TYPES=application/pdf,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv
MAX_IMAGE_SIZE_MB=10
IMAGE_ALLOWED_TYPES=image/png,image/jpeg,image/jpg,image/gif,image/webp
MAX_VOICE_SIZE_MB=15
VOICE_ALLOWED_TYPES=audio/ogg,audio/mpeg,audio/mp3,audio/mp4,audio/m4a,audio/wav,audio/webm,audio/aac
MAX_VIDEO_SIZE_MB=100
VIDEO_ALLOWED_TYPES=video/mp4,video/webm,video/ogg,video/quicktime,video/x-matroska,video/3gpp

# File encryption at rest (envelope encryption). Set this to a real
# random 32-byte value (hex or base64) in production.
UPLOAD_ENCRYPTION_KEY=

# Secure download links
UPLOAD_LINK_SECRET=change-this-to-a-long-random-string
UPLOAD_LINK_TTL_MINUTES=15

# Stickers (Telegram sticker-pack import — see helpers/stickerImport.js)
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
# Optional: where imported sticker files are stored (defaults to a
# "stickers" folder inside UPLOAD_DIR)
# STICKERS_DIR=./uploads/stickers
MAX_STICKERS_PER_PACK=200

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info
LOG_TO_CONSOLE=true

# OTP (phone verification, password reset)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
